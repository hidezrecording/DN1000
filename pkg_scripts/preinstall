#!/bin/bash
# DN1000 installer preinstall: wipe all previous versions
# Removes Hamamatsu 1000 and DN1000 from all locations
#
# FIX APPLIED 2026-10-17 (approved by Nathan): pkg preinstall scripts
# run as ROOT, so $HOME is /var/root — NOT the installing user's home.
# The shipped script used $HOME for the user-library wipes and the
# AU-cache clear, so those steps silently targeted root's home and
# never touched the real user's files — the exact root cause diagnosed
# for Western Compressor in Luna. Resolve the console user's home
# explicitly (same pattern as the fixed Western Compressor preinstall,
# shipped in WC 1.1.3) and use it for all user-domain paths. Also clear
# the AudioUnitCache directory, not just the single .cache file.
# Script-only change — no DSP/GUI/audio change; ships with DN1000's
# next installer.

CONSOLE_USER="$(stat -f '%Su' /dev/console 2>/dev/null)"
USER_HOME=""
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
  USER_HOME="$(dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
fi
if [ -z "$USER_HOME" ] || [ ! -d "$USER_HOME" ]; then
  USER_HOME=""
  for d in /Users/*; do
    [ -d "$d/Library" ] && USER_HOME="$d" && break
  done
fi

for NAME in "Hamamatsu 1000" "DN1000"; do
  # System library
  rm -rf "/Library/Audio/Plug-Ins/VST3/$NAME.vst3"
  rm -rf "/Library/Audio/Plug-Ins/Components/$NAME.component"
  rm -rf "/Applications/$NAME.app"
  rm -rf "/Applications/$NAME Test Host.app"

  # User library (console user's real home — see note above)
  if [ -n "$USER_HOME" ]; then
    rm -rf "$USER_HOME/Library/Audio/Plug-Ins/VST3/$NAME.vst3"
    rm -rf "$USER_HOME/Library/Audio/Plug-Ins/Components/$NAME.component"
  fi
done

# Clear AU caches to force rescan (system + console user)
rm -f "/Library/Caches/com.apple.audiounits.cache" 2>/dev/null
rm -rf "/Library/Caches/AudioUnitCache" 2>/dev/null
if [ -n "$USER_HOME" ]; then
  rm -f "$USER_HOME/Library/Caches/com.apple.audiounits.cache"
  rm -rf "$USER_HOME/Library/Caches/AudioUnitCache"
fi
killall -9 AudioComponentRegistrar 2>/dev/null || true

exit 0
